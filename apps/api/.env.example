# Copy to apps/api/.env and fill in. Never commit .env.

PORT=4000
# Comma-separated list of allowed frontend origins
WEB_ORIGIN=http://localhost:3000

# PostgreSQL 15 (JD)
DATABASE_URL=postgresql://irpc:irpc@localhost:5432/irpc

# Auth: at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# SMS: textbee or mock
SMS_PROVIDER=mock
TEXTBEE_API_URL=https://api.textbee.dev/api/v1
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=

# Incoming webhook subscription secret (for future inbound route)
TEXTBEE_WEBHOOK_SECRET=
