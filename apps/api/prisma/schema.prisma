datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

// ─────────────── ENUMS ───────────────

enum Role {
  USER
  PLANT_STAFF
  ADMIN
  MAO_STAFF
}

enum AccountType {
  FARMER
  COOPERATIVE
  BUYER
  INSTITUTION
}

enum Language {
  HIL
  EN
}

enum OrderType {
  BUY_RICE
  SELL_PALAY
  SERVICE
}

enum OrderStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  SCHEDULED
  PREPARING
  RECEIVED
  WEIGHED
  DRYING
  MILLING
  READY_FOR_PICKUP
  PAID
  COMPLETED
}

enum PalayCondition {
  FRESH
  DRY
}

enum ServiceType {
  DRYING
  MILLING
  DRYING_AND_MILLING
}

enum DeliveryMethod {
  SELF_DELIVER
  IRPC_PICKUP
}

enum PriceItem {
  PALAY_FRESH
  PALAY_DRY
  RICE
  DRYING_FEE
  MILLING_FEE
}

enum PriceBasis {
  MARKET
  NFA
}

enum SmsDirection {
  OUTBOUND
  INBOUND
}

enum BatchStatus {
  NONE       // received from farmers, not yet drying
  DRYING
  MILLING
  COMPLETE
  BAD_INPUT  // soft-deleted: row is kept, but excluded from every cost/expense total
  DAMAGED    // whole batch written off: its cost still counts as an expense
}

// ─────────────── MODELS ───────────────

model User {
  id           Int          @id @default(autoincrement())
  name         String
  phone        String       @unique
  pinHash      String
  role         Role         @default(USER)
  accountType  AccountType?
  language     Language     @default(HIL)
  municipality String?
  cooperative  String?
  consentAt    DateTime?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())

  orders       Order[]           @relation("OrderCustomer")
  events       OrderEvent[]
  prices       Price[]
  stockChanges StockAdjustment[]

  batchesCreated BatchRecord[] @relation("BatchCreator")
  batchesFlagged BatchRecord[] @relation("BatchBadInputBy")
  batchSales     BatchSale[]
  batchEvents    BatchEvent[]
  batchDamages   BatchDamage[]
}

// Short-lived SMS challenge. The plaintext code is never stored.
model PhoneVerification {
  phone     String   @id
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  sentAt    DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RiceType {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  stockKg     Decimal  @default(0) @db.Decimal(12, 2)
  isActive    Boolean  @default(true)

  prices       Price[]
  orders       Order[]
  stockChanges StockAdjustment[]
}

model Price {
  id          Int        @id @default(autoincrement())
  item        PriceItem
  riceTypeId  Int?
  riceType    RiceType?  @relation(fields: [riceTypeId], references: [id])
  commodity   String     @default("rice")
  pricePerKg  Decimal    @db.Decimal(10, 2)
  basis       PriceBasis @default(MARKET)
  effectiveAt DateTime   @default(now())
  createdById Int
  createdBy   User       @relation(fields: [createdById], references: [id])

  @@index([item, riceTypeId, effectiveAt])
}

model Order {
  id                 Int             @id @default(autoincrement())
  type               OrderType
  status             OrderStatus     @default(PENDING)
  commodity          String          @default("rice")
  customerId         Int
  customer           User            @relation("OrderCustomer", fields: [customerId], references: [id])
  contactName        String
  contactPhone       String
  requestedKg        Decimal         @db.Decimal(12, 2)
  preferredDate      DateTime
  scheduledDate      DateTime?
  riceTypeId         Int?
  riceType           RiceType?       @relation(fields: [riceTypeId], references: [id])
  palayCondition     PalayCondition?
  variety            String?
  deliveryMethod     DeliveryMethod?
  serviceType        ServiceType?
  unitPrice          Decimal?        @db.Decimal(10, 2)
  dryingRate         Decimal?        @db.Decimal(10, 2)
  millingRate        Decimal?        @db.Decimal(10, 2)
  wetKg              Decimal?        @db.Decimal(12, 2)
  dryKg              Decimal?        @db.Decimal(12, 2)
  riceKg             Decimal?        @db.Decimal(12, 2)
  weightConfirmedAt DateTime?
  estimatedAmount    Decimal         @db.Decimal(12, 2)
  finalAmount        Decimal?        @db.Decimal(12, 2)
  rejectReason       String?
  paidAt             DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  events  OrderEvent[]
  smsLogs SmsLog[]
  batchItems BatchItem[]
  batchSales BatchSale[]

  @@index([status, type])
  @@index([customerId])
}

model OrderEvent {
  id         Int          @id @default(autoincrement())
  orderId    Int
  order      Order        @relation(fields: [orderId], references: [id])
  fromStatus OrderStatus?
  toStatus   OrderStatus
  kg         Decimal?     @db.Decimal(12, 2)
  note       String?
  actorId    Int?
  actor      User?        @relation(fields: [actorId], references: [id])
  createdAt  DateTime     @default(now())

  @@index([orderId])
}

model StockAdjustment {
  id         Int      @id @default(autoincrement())
  riceTypeId Int
  riceType   RiceType @relation(fields: [riceTypeId], references: [id])
  changeKg   Decimal  @db.Decimal(12, 2)
  reason     String
  orderId    Int?
  actorId    Int?
  actor      User?    @relation(fields: [actorId], references: [id])
  createdAt  DateTime @default(now())
}

model SmsLog {
  id         Int          @id @default(autoincrement())
  direction  SmsDirection
  phone      String
  message    String
  status     String       @default("QUEUED")
  providerId String?
  orderId    Int?
  order      Order?       @relation(fields: [orderId], references: [id])
  createdAt  DateTime     @default(now())

  @@index([phone])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ─────────────── BATCHES (drying + milling) ───────────────

// One processing run. Groups several farmers' SELL_PALAY orders (BatchItem),
// freezes the drying/milling rates at the time each stage starts, and keeps the
// cost totals. Never hard-delete: use BAD_INPUT.
model BatchRecord {
  id     Int         @id @default(autoincrement())
  code   String      @unique // e.g. B-20261015-001
  status BatchStatus @default(NONE)

  wetKg     Decimal  @db.Decimal(12, 2) // sum of items, as received
  dryKg     Decimal? @db.Decimal(12, 2) // after drying
  riceKg    Decimal? @db.Decimal(12, 2) // after milling
  damagedKg Decimal  @default(0) @db.Decimal(12, 2) // running total of BatchDamage.kg

  // Rates (per kg) frozen when each stage starts. Dry palay can skip drying.
  dryingRate  Decimal? @db.Decimal(10, 2)
  millingRate Decimal? @db.Decimal(10, 2)

  // Cost snapshots. totalCost = palayCost + dryingCost + millingCost.
  palayCost   Decimal @default(0) @db.Decimal(12, 2) // sum of BatchItem.orderCost
  dryingCost  Decimal @default(0) @db.Decimal(12, 2)
  millingCost Decimal @default(0) @db.Decimal(12, 2)
  totalCost   Decimal @default(0) @db.Decimal(12, 2)

  // Dates
  receivedAt       DateTime
  dryingStartedAt  DateTime?
  dryingEndedAt    DateTime?
  millingStartedAt DateTime?
  millingEndedAt   DateTime?
  completedAt      DateTime?

  // Soft delete (BAD_INPUT)
  badInputAt           DateTime?
  badInputReason       String?
  badInputById         Int?
  badInputBy           User?        @relation("BatchBadInputBy", fields: [badInputById], references: [id])
  statusBeforeBadInput BatchStatus? // so it can be restored

  createdById Int?
  createdBy   User?    @relation("BatchCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items   BatchItem[]
  sales   BatchSale[]
  damages BatchDamage[]
  events  BatchEvent[]

  @@index([status, receivedAt])
  @@index([completedAt])
}

// A farmer's SELL_PALAY order (or part of it) placed into a batch.
// Price and cost are snapshots, so later price changes never rewrite history.
model BatchItem {
  id         Int         @id @default(autoincrement())
  batchId    Int
  batch      BatchRecord @relation(fields: [batchId], references: [id])
  orderId    Int
  order      Order       @relation(fields: [orderId], references: [id])
  farmerName String // snapshot of Order.contactName
  kg         Decimal     @db.Decimal(12, 2)
  unitPrice  Decimal     @db.Decimal(10, 2) // palay price per kg at that time
  orderCost  Decimal     @db.Decimal(12, 2) // what IRPC paid for these kg
  soldAt     DateTime // when the farmer's palay was received/weighed
  paidAt     DateTime?

  @@unique([batchId, orderId])
  @@index([orderId])
}

// Who the finished rice went to (BUY_RICE side).
model BatchSale {
  id         Int         @id @default(autoincrement())
  batchId    Int
  batch      BatchRecord @relation(fields: [batchId], references: [id])
  buyerId    Int
  buyer      User        @relation(fields: [buyerId], references: [id])
  buyerName  String // snapshot
  orderId    Int?
  order      Order?      @relation(fields: [orderId], references: [id])
  kg         Decimal     @db.Decimal(12, 2)
  pricePerKg Decimal     @db.Decimal(10, 2)
  amount     Decimal     @db.Decimal(12, 2)
  soldAt     DateTime

  @@index([batchId])
  @@index([buyerId])
}

// Partial or full damage. The batch keeps its stage status for partial damage;
// it only flips to DAMAGED when the whole batch is written off.
model BatchDamage {
  id           Int         @id @default(autoincrement())
  batchId      Int
  batch        BatchRecord @relation(fields: [batchId], references: [id])
  fromStatus   BatchStatus // stage it was in: NONE or COMPLETE only (enforce in service)
  kg           Decimal     @db.Decimal(12, 2)
  costAmount   Decimal     @db.Decimal(12, 2) // cost of the damaged kg, counted as expense
  note         String?
  occurredAt   DateTime    @default(now())
  recordedById Int?
  recordedBy   User?       @relation(fields: [recordedById], references: [id])

  @@index([batchId])
}

// Status history, same idea as OrderEvent. Gives you a date for every transition.
model BatchEvent {
  id         Int          @id @default(autoincrement())
  batchId    Int
  batch      BatchRecord  @relation(fields: [batchId], references: [id])
  fromStatus BatchStatus?
  toStatus   BatchStatus
  note       String?
  actorId    Int?
  actor      User?        @relation(fields: [actorId], references: [id])
  createdAt  DateTime     @default(now())

  @@index([batchId])
}
