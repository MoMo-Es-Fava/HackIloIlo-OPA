datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

// ─────────────── ENUMS ───────────────

enum Role {
  USER
  PLANT_STAFF
  ADMIN
  MAO_STAFF
}

enum AccountType {
  FARMER
  COOPERATIVE
  BUYER
  INSTITUTION
}

enum Language {
  HIL
  EN
}

enum OrderType {
  BUY_RICE
  SELL_PALAY
  SERVICE
}

enum OrderStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  SCHEDULED
  PREPARING
  RECEIVED
  WEIGHED
  DRYING
  MILLING
  READY_FOR_PICKUP
  PAID
  COMPLETED
}

enum PalayCondition {
  FRESH
  DRY
}

enum ServiceType {
  DRYING
  MILLING
  DRYING_AND_MILLING
}

enum DeliveryMethod {
  SELF_DELIVER
  IRPC_PICKUP
}

enum PriceItem {
  PALAY_FRESH
  PALAY_DRY
  RICE
  DRYING_FEE
  MILLING_FEE
}

enum PriceBasis {
  MARKET
  NFA
}

enum SmsDirection {
  OUTBOUND
  INBOUND
}

enum BatchStatus {
  NONE
  DRYING
  MILLING
  COMPLETE
  BAD_INPUT
  DAMAGED
}

// ─────────────── MODELS ───────────────

model User {
  id           Int          @id @default(autoincrement())
  name         String
  phone        String       @unique
  pinHash      String
  role         Role         @default(USER)
  accountType  AccountType?
  language     Language     @default(HIL)
  municipality String?
  cooperative  String?
  consentAt    DateTime?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  phoneVerifiedAt DateTime?
  weeklyPriceNotifications WeeklyPriceNotification[]

  orders       Order[]           @relation("OrderCustomer")
  events       OrderEvent[]
  prices       Price[]
  stockChanges StockAdjustment[]
  batchesCreated BatchRecord[] @relation("BatchCreator")
  batchesFlagged BatchRecord[] @relation("BatchBadInputBy")
  batchSales     BatchSale[]
  batchEvents    BatchEvent[]
  batchDamages   BatchDamage[]
}

// Short-lived SMS challenge. The plaintext code is never stored.
model PhoneVerification {
  phone     String   @id
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  sentAt    DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WeeklyPriceNotification {
  id Int @id @default(autoincrement())
  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart DateTime @db.Date
  status String @default("PENDING")
  message String?
  providerId String?
  queuedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, weekStart])
  @@index([status, weekStart])
}

model RiceType {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  stockKg     Decimal  @default(0) @db.Decimal(12, 2)
  isActive    Boolean  @default(true)

  prices       Price[]
  orders       Order[]
  stockChanges StockAdjustment[]
}

model Price {
  id          Int        @id @default(autoincrement())
  item        PriceItem
  riceTypeId  Int?
  riceType    RiceType?  @relation(fields: [riceTypeId], references: [id])
  commodity   String     @default("rice")
  pricePerKg  Decimal    @db.Decimal(10, 2)
  basis       PriceBasis @default(MARKET)
  effectiveAt DateTime   @default(now())
  createdById Int
  createdBy   User       @relation(fields: [createdById], references: [id])

  @@index([item, riceTypeId, effectiveAt])
}

model Order {
  id                 Int             @id @default(autoincrement())
  type               OrderType
  status             OrderStatus     @default(PENDING)
  commodity          String          @default("rice")
  customerId         Int
  customer           User            @relation("OrderCustomer", fields: [customerId], references: [id])
  contactName        String
  contactPhone       String
  requestedKg        Decimal         @db.Decimal(12, 2)
  preferredDate      DateTime
  scheduledDate      DateTime?
  riceTypeId         Int?
  riceType           RiceType?       @relation(fields: [riceTypeId], references: [id])
  palayCondition     PalayCondition?
  variety            String?
  deliveryMethod     DeliveryMethod?
  serviceType        ServiceType?
  unitPrice          Decimal?        @db.Decimal(10, 2)
  dryingRate         Decimal?        @db.Decimal(10, 2)
  millingRate        Decimal?        @db.Decimal(10, 2)
  wetKg              Decimal?        @db.Decimal(12, 2)
  dryKg              Decimal?        @db.Decimal(12, 2)
  riceKg             Decimal?        @db.Decimal(12, 2)
  weightConfirmedAt DateTime?
  estimatedAmount    Decimal         @db.Decimal(12, 2)
  finalAmount        Decimal?        @db.Decimal(12, 2)
  rejectReason       String?
  paidAt             DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  events  OrderEvent[]
  smsLogs SmsLog[]
  batchItems BatchItem[]
  batchSales BatchSale[]

  @@index([status, type])
  @@index([customerId])
}

model OrderEvent {
  id         Int          @id @default(autoincrement())
  orderId    Int
  order      Order        @relation(fields: [orderId], references: [id])
  fromStatus OrderStatus?
  toStatus   OrderStatus
  kg         Decimal?     @db.Decimal(12, 2)
  note       String?
  actorId    Int?
  actor      User?        @relation(fields: [actorId], references: [id])
  createdAt  DateTime     @default(now())

  @@index([orderId])
}

model StockAdjustment {
  id         Int      @id @default(autoincrement())
  riceTypeId Int
  riceType   RiceType @relation(fields: [riceTypeId], references: [id])
  changeKg   Decimal  @db.Decimal(12, 2)
  reason     String
  orderId    Int?
  actorId    Int?
  actor      User?    @relation(fields: [actorId], references: [id])
  createdAt  DateTime @default(now())
}

model SmsLog {
  id         Int          @id @default(autoincrement())
  direction  SmsDirection
  phone      String
  message    String
  status     String       @default("QUEUED")
  providerId String?
  orderId    Int?
  order      Order?       @relation(fields: [orderId], references: [id])
  createdAt  DateTime     @default(now())

  @@index([phone])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model BatchRecord {
  id     Int         @id @default(autoincrement())
  code   String      @unique
  status BatchStatus @default(NONE)

  wetKg     Decimal  @db.Decimal(12, 2)
  dryKg     Decimal? @db.Decimal(12, 2)
  riceKg    Decimal? @db.Decimal(12, 2)
  damagedKg Decimal  @default(0) @db.Decimal(12, 2)

  dryingRate  Decimal? @db.Decimal(10, 2)
  millingRate Decimal? @db.Decimal(10, 2)

  palayCost  Decimal @default(0) @db.Decimal(12, 2)
  dryingCost Decimal @default(0) @db.Decimal(12, 2)
  millingCost Decimal @default(0) @db.Decimal(12, 2)
  totalCost  Decimal @default(0) @db.Decimal(12, 2)

  receivedAt       DateTime
  dryingStartedAt  DateTime?
  dryingEndedAt    DateTime?
  millingStartedAt DateTime?
  millingEndedAt   DateTime?
  completedAt      DateTime?

  badInputAt           DateTime?
  badInputReason       String?
  badInputById         Int?
  badInputBy           User?        @relation("BatchBadInputBy", fields: [badInputById], references: [id])
  statusBeforeBadInput BatchStatus?

  createdById Int?
  createdBy   User?    @relation("BatchCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items   BatchItem[]
  sales   BatchSale[]
  damages BatchDamage[]
  events  BatchEvent[]

  @@index([status, receivedAt])
  @@index([completedAt])
}

model BatchItem {
  id         Int         @id @default(autoincrement())
  batchId    Int
  batch      BatchRecord @relation(fields: [batchId], references: [id])
  orderId    Int
  order      Order       @relation(fields: [orderId], references: [id])
  farmerName String
  kg         Decimal     @db.Decimal(12, 2)
  unitPrice  Decimal     @db.Decimal(10, 2)
  orderCost  Decimal     @db.Decimal(12, 2)
  soldAt     DateTime
  paidAt     DateTime?

  @@unique([batchId, orderId])
  @@index([orderId])
}

model BatchSale {
  id         Int         @id @default(autoincrement())
  batchId    Int
  batch      BatchRecord @relation(fields: [batchId], references: [id])
  buyerId    Int
  buyer      User        @relation(fields: [buyerId], references: [id])
  buyerName  String
  orderId    Int?
  order      Order?      @relation(fields: [orderId], references: [id])
  kg         Decimal     @db.Decimal(12, 2)
  pricePerKg Decimal     @db.Decimal(10, 2)
  amount     Decimal     @db.Decimal(12, 2)
  soldAt     DateTime

  @@index([batchId])
  @@index([buyerId])
}

model BatchDamage {
  id           Int         @id @default(autoincrement())
  batchId      Int
  batch        BatchRecord @relation(fields: [batchId], references: [id])
  fromStatus   BatchStatus
  kg           Decimal     @db.Decimal(12, 2)
  costAmount   Decimal     @db.Decimal(12, 2)
  note         String?
  occurredAt   DateTime    @default(now())
  recordedById Int?
  recordedBy   User?       @relation(fields: [recordedById], references: [id])

  @@index([batchId])
}

model BatchEvent {
  id         Int          @id @default(autoincrement())
  batchId    Int
  batch      BatchRecord  @relation(fields: [batchId], references: [id])
  fromStatus BatchStatus?
  toStatus   BatchStatus
  note       String?
  actorId    Int?
  actor      User?        @relation(fields: [actorId], references: [id])
  createdAt  DateTime     @default(now())

  @@index([batchId])
}
